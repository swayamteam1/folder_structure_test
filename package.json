{
  "name": "pern-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready PERN Monorepo (PostgreSQL, Express, React+Vite+Tailwind, Node) in full TypeScript",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter ./apps/* --parallel run dev",
    "dev:client": "pnpm --filter @apps/client run dev",
    "dev:server": "pnpm --filter @apps/server run dev",
    "dev:worker": "pnpm --filter @apps/worker run dev",
    "build": "pnpm --filter ./packages/* run build && pnpm --filter ./apps/* run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "db:seed": "node scripts/seed.js",
    "generate:module": "node scripts/generate-module.js",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "pg": "^8.13.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3"
}
