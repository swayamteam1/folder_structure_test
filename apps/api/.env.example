# Server Port & Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Credentials (pg)
PGHOST=localhost
PGPORT=5432
PGDATABASE=pern_monorepo_dev
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pern_monorepo_dev

# Connection Pool Settings
PG_MAX_POOL=20
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=5000

# Security / JWT
JWT_SECRET=pern_secret_jwt_key_987654321
JWT_EXPIRES_IN=7d

# Allowed Client Origin
CLIENT_URL=http://localhost:5173
