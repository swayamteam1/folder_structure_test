# Monorepo Global Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_PORT=5173

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=pern_monorepo_dev
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pern_monorepo_dev

# JWT Auth Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# Client URL
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api
